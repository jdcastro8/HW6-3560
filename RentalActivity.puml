@startuml
title School Facility Rental - Activity

|Renter|
start
:Choose facility, date, time,
and event type;

|Website|
:Check availability;

while (Facility available?) is (no)
    :Show not available;

    |Renter|
    if (Try another date?) then (yes)
        :Choose another date and time;
        |Website|
        :Check availability;
    else (no)
        stop
    endif
endwhile (yes)

|Renter|
:Enter contact information;
:Submit request;

|Website|
:Record request;
:Send request for review;

|School Staff|
:Review request;

if (Request approved?) then (approved)
    :Approve request;

    |Website|
    :Request payment;

    |Payment Service|
    :Process payment;

    if (Payment successful?) then (payment succeeds)
        |Website|
        :Save booking;

        |Email Service|
        :Send confirmation email;

        |Renter|
        :Receive confirmation;
        stop
    else (payment fails)
        |Website|
        :Record payment failure;

        |Email Service|
        :Send payment failure email;

        |Renter|
        :Receive payment failure notice;
        stop
    endif

else (rejected)
    :Reject request;

    |Website|
    :Record rejection;

    |Email Service|
    :Send rejection email;

    |Renter|
    :Receive rejection notice;
    stop
endif

@enduml
